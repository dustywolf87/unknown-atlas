  boot: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M14 3 8.2 12.5l-1.9-2.1L1 20h22L14 3zm-5 8.7 1.6 1.8-3.4 5.5H4.5L9 11.7z"/></svg>',
  download: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v12m0 0-4-4m4 4 4-4M4 19h16"/></svg>',
  'arrow-right': '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14m0 0-6-6m6 6-6 6"/></svg>',
};
---

