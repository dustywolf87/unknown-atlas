---
import { site } from '../site';

interface Props {
  context?: 'footer' | 'route';
}

const { context = 'footer' } = Astro.props;

const copy = {
  footer: {
    eyebrow: 'KEEP THE ATLAS GOING',
    title: 'SE TI È STATO UTILE, PUOI OFFRIRMI UN CAFFÈ',
    text: 'Piccolo gesto, grande aiuto per continuare a raccogliere percorsi, appunti e cose da condividere.',
  },
  route: {
    eyebrow: 'SUPPORT THE ATLAS',
    title: 'TI È STATA UTILE QUESTA TRACCIA?',
    text: 'Se questa traccia ti ha portato da qualche parte, puoi contribuire a mantenere vivo questo piccolo archivio.',
  },
}[context];
---

{site.kofiUrl && (
  <section class={`kofi-block kofi-${context}`} aria-label="Support UNKNOWN ATLAS">
    <div class="container">
      <div class="kofi-copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2>{copy.title}</h2>
        <p>{copy.text}</p>
      </div>
      <a class="kofi-button" href={site.kofiUrl} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">☕</span> BUY ME A COFFEE <b>↗</b>
      </a>
    </div>
  </section>
)}
