---
import { site } from '../site';

interface Props {
  context?: 'footer' | 'route';
}

const { context = 'footer' } = Astro.props;

const copy = {
  footer: {
    eyebrow: 'KEEP THE ATLAS GOING',
    title: 'IF IT HELPED YOU, YOU CAN BUY ME A COFFEE',
    text: 'A small gesture, a big help to keep collecting routes, notes and things worth sharing.',
  },
  route: {
    eyebrow: 'SUPPORT THE ATLAS',
    title: 'DID THIS TRACK HELP YOU?',
    text: 'If this track took you somewhere, you can help keep this small archive alive.',
  },
}[context];
---

{site.kofiUrl && (
  <section class={`kofi-block kofi-${context}`} aria-label="Support UNKNOWN ATLAS">
    <div class="container">
      <div class="kofi-copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2>{copy.title}</h2>
        <p>{copy.text}</p>
      </div>
      <a class="kofi-button" href={site.kofiUrl} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">☕</span> BUY ME A COFFEE <b>↗</b>
      </a>
    </div>
  </section>
)}
